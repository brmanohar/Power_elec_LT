TEXT -120 736 Left 2 !*\n.param L=75u ; inductance value\n.param Vin=12 ; input voltage\n.param Fsw=100k ; switching frequency\n.param Vp=2 ; this is the sawtooth peak voltage\n*
TEXT 832 -168 Left 2 !*\n.param Gfc=-9.2 ; magnitude at crossover *\n.param PS=-146 ; phase lag at crossover *\n*\n* Enter Design Goals Information Here *\n*\n.param fc=5k ; targeted crossover *\n.param PM=45 ; choose phase margin at crossover *\n*\n* Capture the double zero position and \n* one of the pole position\n*\n.param fz1=2k\n.param fz2=2k\n.param fp2=50k ; this pole is usually placed at Fsw/2\n*\n* Enter the Values for Vout and Bridge Bias Current *\n*\n.param Vout=5\n.param Ibias=2m\n.param Vref=2.5\n*\n* Do not edit the below lines *\n*\n.param Rlower={Vref/Ibias}\n.param Rupper={(Vout-Vref)/Ibias}\n.param boost={PM-PS-90}\n.param Kf={(tan((boost/4+45)*pi/180))**2}\n.param fz1={fc/sqrt(Kf)}\n.param fz2={fc/sqrt(Kf)}\n.param fp1={fc*sqrt(Kf)}\n.param fp2={fc*sqrt(Kf)}\n*\n.param G={10**(-Gfc/20)}\n.param a={sqrt((fc**2/fp1**2)+1)}\n.param b={sqrt((fc**2/fp2**2)+1)}\n.param c={sqrt((fz1**2/fc**2)+1)}\n.param d={sqrt((fc**2/fz2**2)+1)}\n.param R2={((a*b/(c*d))/(fp1-fz1))*Rupper*G*fp1}\n.param C1={1/(2*pi*fz1*R2)}\n.param C2={C1/(C1*R2*2*pi*fp1-1)}\n.param C3={(fp2-fz2)/(2*pi*Rupper*fp2*fz2)}\n.param R3={Rupper*fz2/(fp2-fz2)}\n.param G0={((R2*C1)/(Rupper*(C1+C2)))*c*d/(a*b)} ; Gain at fc sanity check *\n \n*\n*\n* Choose op amp characteristics *\n*\n.param AOL=90 ; open-loop gain in dB *\n.param POLE=300 ; low-frequency pole *\n.param VHIGH=5 ; upper output level *\n.param VLOW=100m ; lower output level *\n*\n* Do not edit these lines *\n*\n.param GAIN={10**(AOL/20)}\n.param COL={1/(6.28*(GAIN/100u)*POLE)}\n.param ROL={GAIN/100u}\n*
