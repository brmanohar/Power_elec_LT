TEXT 816 -432 Left 2 !.ac dec 1000 10 100kHz
TEXT 808 -432 Left 2 !*\n.param L=75u ; inductance value\n.step param Vin list 10 20 ; input voltage\n.param Fsw=100k ; switching frequency\n.param Vp=2 ; this is the sawtooth peak voltage\n*
TEXT 832 -168 Left 2 !*\n* Enter the Values for Vout and Bridge Bias Current *\n*\n.param Vout=5\n.param Ibias=2m\n.param Vref=2.5\n*\n \n*\n.param Gfc=-9.2 ; magnitude at crossover *\n.param PS=-146 ; phase lag at crossover *\n*\n* Enter Design Goals Information Here *\n*\n.param fc=5k ; targeted crossover *\n.param PM=45 ; choose phase margin at crossover *\n*\n* Capture the double zero position and \n* one of the pole position\n*\n \n \n* Do not edit the below lines *\n*\n.param Rupper = 10k\n.param G={10**(-Gfc/20)}\n.param boost={PM-PS-90}\n.param pi= 3.14159\n.param K={(tan((boost/4+45)*pi/180))**2}\n.param C2={1/(2*pi*fc*G*Rupper)}\n.param C1={C2*(K-1)}\n.param R2={sqrt(k)/(2*pi*fc*C1)}\n.param R3={Rupper/(k-1)}\n.param C3={1/(2*pi*fc*sqrt(k)*R3)}\n \n \n*\n*\n* Choose op amp characteristics *\n*\n.param AOL=90 ; open-loop gain in dB *\n.param POLE=300 ; low-frequency pole *\n.param VHIGH=5 ; upper output level *\n.param VLOW=100m ; lower output level *\n*\n* Do not edit these lines *\n*\n.param GAIN={10**(AOL/20)}\n.param COL={1/(6.28*(GAIN/100u)*POLE)}\n.param ROL={GAIN/100u}\n*
